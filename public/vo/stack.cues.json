[
  {
    "start": 0.0,
    "end": 4.069,
    "text": "Cairn takes the stone out of his hand and puts it on the pile."
  },
  {
    "start": 4.519,
    "end": 8.007,
    "text": "That height is the only proof he trusts after a cold Thursday."
  },
  {
    "start": 8.457,
    "end": 10.491,
    "text": "A stone is a session that happened."
  },
  {
    "start": 10.941,
    "end": 12.104,
    "text": "Cairn can see it."
  },
  {
    "start": 12.554,
    "end": 15.751,
    "text": "Tomorrow the pile is still there even if Thursday comes back."
  },
  {
    "start": 16.201,
    "end": 18.235,
    "text": "That is the point of a cairn."
  },
  {
    "start": 18.685,
    "end": 19.848,
    "text": "Marks on a path."
  },
  {
    "start": 20.298,
    "end": 21.751,
    "text": "Not proof of a soulmate."
  },
  {
    "start": 22.201,
    "end": 24.817,
    "text": "He does not need a new species of work."
  },
  {
    "start": 25.267,
    "end": 26.429,
    "text": "He needs another stone."
  },
  {
    "start": 26.879,
    "end": 28.332,
    "text": "The throw is the move."
  },
  {
    "start": 28.782,
    "end": 30.526,
    "text": "The stone leaves the pointing hand."
  },
  {
    "start": 30.976,
    "end": 32.72,
    "text": "It lands on a real pile."
  },
  {
    "start": 33.17,
    "end": 34.042,
    "text": "Finish the session."
  },
  {
    "start": 34.492,
    "end": 36.236,
    "text": "Put the stone on the pile."
  },
  {
    "start": 36.686,
    "end": 39.883,
    "text": "He leaves the room with a taller cairn than he entered."
  },
  {
    "start": 40.333,
    "end": 41.496,
    "text": "That is the record."
  },
  {
    "start": 41.946,
    "end": 42.817,
    "text": "Not the mood."
  },
  {
    "start": 43.267,
    "end": 44.43,
    "text": "Not the Tuesday glow."
  }
]
